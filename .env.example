# Copy to .env and fill in.

# --- LLM access ---
# Every role of every run goes through OpenRouter (config/models.yaml, active: target_family).
OPENROUTER_API_KEY=
# Recorded in the run manifest only; routing comes from config/models.yaml.
USE_OPENROUTER=true
# Needed only if config/models.yaml is switched to active: interim_openai.
OPENAI_API_KEY=

# --- Evidence sources ---
# Required in practice: keyless OpenAlex gets ~100 searches/day per IP, not enough for
# one run. Free key: https://help.openalex.org/api/authentication/
OPENALEX_API_KEY=
# Polite pool for CrossRef / OpenAlex — put a contact email here.
CONTACT_EMAIL=you@example.com
# Optional; raises the PubMed rate limit.
NCBI_API_KEY=
# Semantic Scholar is disabled in config/settings.py (use_semantic_scholar = False).
SEMANTIC_SCHOLAR_API_KEY=
